<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Bunker.uss?fileID=7433441132597879392&amp;guid=aef80d20ad3ecfa4cbff58a742e728d1&amp;type=3#Bunker"/>
    <ui:VisualElement name="hud" picking-mode="Ignore" class="screen">
        <ui:VisualElement picking-mode="Ignore" class="hud-bar">
            <ui:Label name="score" text="SCORE&#10;000000" picking-mode="Ignore" class="hud-stat" style="-unity-text-outline-width: 2px; -unity-text-outline-color: rgb(255, 255, 255);"/>
            <ui:VisualElement picking-mode="Ignore" class="hud-life">
                <ui:VisualElement name="lifebar" picking-mode="Ignore" class="lifebar">
                    <ui:VisualElement name="lifebar-track" picking-mode="Ignore" class="lifebar-track">
                        <ui:VisualElement name="life-fill" picking-mode="Ignore" class="lifebar-fill"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="LIFE" picking-mode="Ignore" class="hud-stat" style="-unity-text-outline-width: 2px; -unity-text-outline-color: rgb(255, 255, 255);"/>
            </ui:VisualElement>
            <ui:Label name="towers" text="TOWERS&#10;0/0" picking-mode="Ignore" class="hud-stat" style="-unity-text-outline-width: 2px; -unity-text-outline-color: rgb(255, 255, 255);"/>
            <ui:Label name="wave" text="WAVE&#10;000000" picking-mode="Ignore" class="hud-stat" style="-unity-text-outline-width: 2px; -unity-text-outline-color: rgb(255, 255, 255);"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
